# Copy to .env and edit. Never commit .env.
# Shared secret for state-changing API calls. The frontend proxy injects it; the browser never sees it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-generate-a-long-random-value

# auto = real model if weights exist, otherwise DEMO MODE;  real = require weights;  demo = always demo
DETECTION_MODE=auto
MODEL_WEIGHTS_PATH=./models/best.onnx
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# SQLite by default. PostgreSQL example (needs psycopg, see backend/requirements-optional.txt):
# DATABASE_URL=postgresql+psycopg://inspection:password@db:5432/inspection
DATABASE_URL=

# Local (non-Docker) PLC simulator settings. The simulator is embedded and listens on loopback only.
PLC_HOST=127.0.0.1
PLC_PORT=5020
PLC_AUTOSTART_SIMULATOR=true
PLC_ALLOW_NON_LOCAL_HOST=false
PLC_TIMEOUT_S=2.0
PLC_RETRIES=3

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
FRONTEND_PORT=8080
